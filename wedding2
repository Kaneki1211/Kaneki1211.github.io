<script>
  // 1. 背景特效 (略)
  const bokehContainer = document.getElementById('bokeh');
  for (let i = 0; i < 15; i++) { const b = document.createElement('div'); b.className = 'bokeh'; b.style.left = Math.random() * 100 + '%'; b.style.top = Math.random() * 100 + '%'; const size = Math.random() * 80 + 40; b.style.width = size + 'px'; b.style.height = size + 'px'; b.style.animationDuration = (Math.random() * 10 + 15) + 's'; b.style.animationDelay = (Math.random() * 5) + 's'; bokehContainer.appendChild(b); }
  const petalsContainer = document.getElementById('petals');
  for (let i = 0; i < 25; i++) { const p = document.createElement('div'); p.className = 'petal'; p.style.left = Math.random() * 100 + '%'; p.style.animationDuration = (Math.random() * 8 + 6) + 's'; p.style.animationDelay = (Math.random() * 10) + 's'; const scale = Math.random() * 0.8 + 0.6; p.style.transform = `scale(${scale})`; petalsContainer.appendChild(p); }

  // 2. 核心滑动引擎 (支持单页内滚动)
  const app = document.getElementById('app');
  const pages = document.querySelectorAll('.page');
  const dots = document.querySelectorAll('.dot');
  let currentIndex = 0, isAnimating = false, startY = 0, startScrollTop = 0, currentTranslateY = 0, isDragging = false;
  
  function getScreenHeight() { return window.innerHeight; }
  function initLayout() {
    const h = getScreenHeight();
    app.style.height = (h * pages.length) + 'px';
    pages.forEach(page => page.style.height = h + 'px');
    app.style.transform = `translateY(${-currentIndex * h}px)`;
  }
  initLayout(); window.addEventListener('resize', initLayout);

  function onStart(e) {
    if (isAnimating) return;
    isDragging = true;
    startY = e.touches ? e.touches[0].clientY : e.clientY;
    startScrollTop = pages[currentIndex].scrollTop; // 记录当前页的初始滚动位置
    app.style.transition = 'none';
    pauseAutoPlay(); // 用户一摸屏幕，立刻暂停自动播放
  }

  function onMove(e) {
    if (!isDragging || isAnimating) return;
    const currentY = e.touches ? e.touches[0].clientY : e.clientY;
    let diff = currentY - startY;

    const currentPage = pages[currentIndex];
    const isScrollable = currentPage.scrollHeight > currentPage.clientHeight;

    // 【核心逻辑】：如果当前页有滚动条，且没有滚到边界，则让当前页自己滚动，不触发全屏翻页
    if (isScrollable) {
      // 向下拉 (diff > 0)，且不在顶部
      if (diff > 0 && startScrollTop > 0) return; 
      // 向上拉 (diff < 0)，且不在底部 (减1防止精度误差)
      if (diff < 0 && startScrollTop < currentPage.scrollHeight - currentPage.clientHeight - 1) return; 
    }

    // 如果不需要内部滚动，或者已经到了边界，则触发全屏翻页
    e.preventDefault(); 

    if ((currentIndex === 0 && diff > 0) || (currentIndex === pages.length - 1 && diff < 0)) diff = diff * 0.3;
    currentTranslateY = -currentIndex * getScreenHeight() + diff;
    app.style.transform = `translateY(${currentTranslateY}px)`;
  }

  function onEnd(e) {
    if (!isDragging) return;
    isDragging = false;
    const endY = e.changedTouches ? e.changedTouches[0].clientY : e.clientY;
    const diff = endY - startY; const threshold = getScreenHeight() * 0.15;
    app.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)';
    let nextPage = currentIndex;
    if (diff < -threshold && currentIndex < pages.length - 1) nextPage = currentIndex + 1;
    else if (diff > threshold && currentIndex > 0) nextPage = currentIndex - 1;
    currentIndex = nextPage; currentTranslateY = -currentIndex * getScreenHeight();
    app.style.transform = `translateY(${currentTranslateY}px)`;
    dots.forEach((dot, i) => dot.classList.toggle('active', i === currentIndex));
    isAnimating = true; setTimeout(() => { isAnimating = false; }, 500);
  }

  app.addEventListener('touchstart', onStart, { passive: true });
  app.addEventListener('touchmove', onMove, { passive: false }); // 需要 preventDefault
  app.addEventListener('touchend', onEnd, { passive: true });
  app.addEventListener('mousedown', onStart); app.addEventListener('mousemove', onMove);
  app.addEventListener('mouseup', onEnd); app.addEventListener('mouseleave', onEnd);
  
  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      if (isAnimating) return; isAnimating = true; pauseAutoPlay();
      currentIndex = parseInt(dot.dataset.index);
      app.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)';
      app.style.transform = `translateY(${-currentIndex * getScreenHeight()}px)`;
      dots.forEach((d, i) => d.classList.toggle('active', i === currentIndex));
      setTimeout(() => { isAnimating = false; }, 500);
    });
  });

  // 3. 自动播放系统
  let autoPlayTimer = null;
  let isAutoPlaying = true;
  const AUTO_PLAY_INTERVAL = 4000; // 4秒翻一页
  const autoPlayBtn = document.getElementById('autoPlayBtn');

  function startAutoPlay() {
    isAutoPlaying = true;
    autoPlayBtn.innerHTML = '⏸';
    clearInterval(autoPlayTimer);
    autoPlayTimer = setInterval(() => {
      if (currentIndex < pages.length - 1) {
        currentIndex++;
        app.style.transition = 'transform 0.8s cubic-bezier(0.645, 0.045, 0.355, 1)';
        app.style.transform = `translateY(${-currentIndex * getScreenHeight()}px)`;
        dots.forEach((dot, i) => dot.classList.toggle('active', i === currentIndex));
      } else {
        pauseAutoPlay(); // 到最后一页自动停止
      }
    }, AUTO_PLAY_INTERVAL);
  }

  function pauseAutoPlay() {
    isAutoPlaying = false;
    autoPlayBtn.innerHTML = '▶';
    clearInterval(autoPlayTimer);
  }

  autoPlayBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    if (isAutoPlaying) pauseAutoPlay(); else startAutoPlay();
  });

  // 页面加载后默认开启自动播放
  startAutoPlay();

  // 4. 地图弹窗逻辑 (略，与上一版相同)
  const HOTEL_NAME = "杭州瑰丽酒店"; const LAT = "27.721203"; const LNG = "111.247284";
  const mapModal = document.getElementById('mapModal');
  document.getElementById('openMapModal').addEventListener('click', () => { mapModal.classList.add('active'); pauseAutoPlay(); });
  document.getElementById('closeMapModal').addEventListener('click', () => mapModal.classList.remove('active'));
  mapModal.addEventListener('click', (e) => { if (e.target === mapModal) mapModal.classList.remove('active'); });
  document.getElementById('btnTencent').addEventListener('click', () => { window.location.href = `https://apis.map.qq.com/uri/v1/routeplan?type=drive&to=${HOTEL_NAME}&tocoord=${LAT},${LNG}&referer=Wedding`; });
  document.getElementById('btnAmap').addEventListener('click', () => { window.location.href = `https://uri.amap.com/navigation?to=${LNG},${LAT},${HOTEL_NAME}&mode=car&coordinate=gaode&callnative=1`; });
  document.getElementById('btnBaidu').addEventListener('click', () => { window.location.href = `https://api.map.baidu.com/direction?destination=latlng:${LAT},${LNG}|name:${HOTEL_NAME}&mode=driving&output=html`; });
  document.getElementById('btnApple').addEventListener('click', () => { window.location.href = `http://maps.apple.com/?ll=${LAT},${LNG}&q=${HOTEL_NAME}`; });
</script>
